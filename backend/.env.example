# ==============================================================================
# AI-Powered Document Intelligence and Knowledge Extraction System - Environment
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="AI Document Intelligence Platform"
DEBUG=True
API_V1_STR=/api

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET=supersecretjwtkey_change_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + pgvector)
# Example for local PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/doc_intelligence
# If DATABASE_URL starts with sqlite, the engine will run in SQLite compatibility mode for quick local dev.
DATABASE_URL=sqlite:///./doc_intelligence.db

# Storage Directories
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# AI Provider Configuration (Options: gemini, openai, ollama, mock)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG & Retrieval Settings
DEFAULT_TOP_K=5
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_MODE=hybrid
OCR_FALLBACK_ENABLED=True
OCR_LANGUAGE=eng
